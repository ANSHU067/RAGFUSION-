RAGFUSION_APP_NAME=RAGFUSION API
RAGFUSION_ENVIRONMENT=development
RAGFUSION_DEBUG=false
RAGFUSION_API_V1_PREFIX=/api/v1
# DATABASE_URL is also accepted; RAGFUSION_DATABASE_URL takes precedence.
RAGFUSION_DATABASE_URL=postgresql+asyncpg://docpro:docpro@localhost:5432/docpro
RAGFUSION_DATABASE_CONNECT_TIMEOUT_SECONDS=20
RAGFUSION_REDIS_URL=redis://localhost:6379/0
RAGFUSION_UPLOAD_DIR=/var/lib/ragfusion/uploads
RAG_VECTOR_STORE_PATH=/var/lib/ragfusion/vectorstore
RAGFUSION_CORS_ORIGINS=["http://localhost:5173"]
RAGFUSION_LOG_LEVEL=INFO
RAGFUSION_JWT_SECRET_KEY=change-me-in-production
RAGFUSION_JWT_ALGORITHM=HS256
RAGFUSION_ACCESS_TOKEN_EXPIRE_MINUTES=15
RAGFUSION_REFRESH_TOKEN_EXPIRE_DAYS=30
RAGFUSION_TRUSTED_PROXIES=[]
RAGFUSION_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1.0
# RAGFUSION_GROQ_API_KEY and DOCPRO_GROQ_API_KEY also work; valid gsk_ aliases win.
GROQ_API_KEY=your_groq_api_key_here
# FastEmbed uses an ONNX model cache, separate from SentenceTransformer caches.
# Download missing model files automatically; offline-only mode is opt-in.
RAGFUSION_EMBEDDING_LOCAL_FILES_ONLY=false
# Optional: set RAGFUSION_EMBEDDING_CACHE_DIR to a writable persistent disk path.
# Default: $XDG_CACHE_HOME/ragfusion/fastembed or ~/.cache/ragfusion/fastembed.
RAGFUSION_EMBEDDING_WARMUP=false
UNSTRUCTURED_DISABLE_NOTICE=1
ANONYMIZE_TELEMETRY=False
CHROMA_TELEMETRY=False
ANONYMIZED_TELEMETRY=False
